---
import PageHero from '../../components/PageHero.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getLangStaticPaths, toLang, useTranslations } from '../../i18n/utils';
import { getProfile } from '../../lib/content';

export function getStaticPaths() {
  return getLangStaticPaths();
}

const lang = toLang(Astro.params.lang);
const t = useTranslations(lang);
const { email, github } = await getProfile();
const githubUrl = `https://github.com/${github}`;
---

<BaseLayout lang={lang} title={t('contact.title')} description={t('contact.description')}>
  <PageHero tile="contact" icon="letter">
    <h1 class="text-title mb-3">{t('contact.title')}</h1>
    <p class="max-w-[var(--measure)]">{t('contact.lead')}</p>
  </PageHero>

  {/* フォームは使わない: 外部 JS と個人情報の保管を避けるため / 폼은 쓰지 않는다: 외부 JS와 개인정보 보관을 피하기 위해 */}
  {/* 連絡手段は本文のリンクではなく、押せるカードとして目立たせる / 연락 수단은 본문 링크가 아니라 누를 수 있는 카드로 눈에 띄게 한다 */}
  <ul class="methods">
    <li>
      <a class="method card" href={githubUrl} data-no-ext>
        <span>
          <span class="method-label">{t('contact.github')}</span>
          <span class="method-value">{githubUrl.replace(/^https:\/\//, '')}</span>
        </span>
        <span class="method-icon" aria-hidden="true">↗</span>
      </a>
    </li>
    <li>
      {
        // メールアドレスが未設定の間は押せないカードにする / 메일 주소가 미설정인 동안은 누를 수 없는 카드로 한다
        email ? (
          <a class="method card" href={`mailto:${email}`}>
            <span>
              <span class="method-label">{t('contact.email')}</span>
              <span class="method-value">{email}</span>
            </span>
            <span class="method-icon" aria-hidden="true">
              →
            </span>
          </a>
        ) : (
          <div class="method card-disabled">
            <span>
              <span class="method-label">{t('contact.email')}</span>
              <span>{t('contact.emailPending')}</span>
            </span>
          </div>
        )
      }
    </li>
  </ul>
</BaseLayout>

<style>
  .methods {
    display: grid;
    gap: 1rem;
    max-width: 48rem;
  }

  @media (min-width: 40rem) {
    .methods {
      grid-template-columns: 1fr 1fr;
    }
  }

  .method {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    min-height: 4rem;
    height: 100%;
    padding: 0.75rem 1.25rem;
  }

  a.method,
  a.method:hover {
    color: var(--text);
    text-decoration: none;
  }

  .method-label {
    display: block;
    font-size: 0.875rem;
    color: var(--muted);
  }

  a .method-value {
    color: var(--accent);
    text-decoration: underline 1px;
    text-underline-offset: 0.2em;
    overflow-wrap: anywhere;
  }

  .method-icon {
    font-size: 1.25rem;
    color: var(--accent);
  }
</style>
