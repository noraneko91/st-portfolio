---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getLangStaticPaths, toLang, useTranslations } from '../../i18n/utils';

export function getStaticPaths() {
  return getLangStaticPaths();
}

const lang = toLang(Astro.params.lang);
const t = useTranslations(lang);
---

<BaseLayout lang={lang} description={t('home.description')}>
  <h1 class="text-display">{t('site.name')}</h1>
</BaseLayout>
