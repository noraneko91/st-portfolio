---
import MiniCareerGraph from '../../components/MiniCareerGraph.astro';
import SkillLogo from '../../components/SkillLogo.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getAlternatePath, getLangStaticPaths, toLang, useTranslations } from '../../i18n/utils';
import {
  formatUsage,
  formatYears,
  getCareers,
  getProfile,
  getProjects,
  getSkillNames,
  getSkillsWithUsage,
  getTotalCareerMonths,
} from '../../lib/content';

export function getStaticPaths() {
  return getLangStaticPaths();
}

const lang = toLang(Astro.params.lang);
const t = useTranslations(lang);

const [profile, careers, projects, skills, totalMonths, skillNames] = await Promise.all([
  getProfile(),
  getCareers(),
  getProjects(),
  getSkillsWithUsage(),
  getTotalCareerMonths(),
  getSkillNames(),
]);

const featured = skills.filter(({ skill }) => skill.data.featured);
const latestProjects = projects.slice(0, 2);

// 成長の流れ: バックエンド → クラウド → フロントエンド (挑戦中)。技術名は skills.yaml から引く
// 성장 경로: 백엔드 → 클라우드 → 프런트엔드 (도전 중). 기술명은 skills.yaml에서 가져온다
const path = [
  { label: t('home.path.backend'), tech: ['java', 'python'], now: false },
  { label: t('home.path.cloud'), tech: ['aws'], now: false },
  { label: t('home.path.frontend'), tech: ['typescript', 'react'], now: true },
].map((step) => ({ ...step, tech: step.tech.map((id) => skillNames.get(id) ?? id).join(' · ') }));
---

<BaseLayout lang={lang} description={t('home.description')} home>
  {/*
    各ページの入口をタイルで並べる。タイルとページ見出しは同じ view-transition-name を持ち、押すとタイルが広がってページになる (ADR 0007)
    각 페이지 입구를 타일로 배치한다. 타일과 페이지 제목은 같은 view-transition-name을 가져, 누르면 타일이 넓어져 페이지가 된다 (ADR 0007)
  */}
  <div class="bento">
    <div class="tile panel tile-profile" style="view-transition-name: tile-profile">
      <p class="tile-prompt font-mono" aria-hidden="true">~/whoami</p>
      <h1 class="tile-name">{profile.displayName}</h1>
      <p class="tile-role">{profile.title[lang]}</p>
      <ol class="path" aria-label={t('home.path.label')}>
        {
          path.map((step, index) => (
            <li class:list={['step', { 'step-now': step.now }]} style={`--i: ${index}`}>
              <span class="step-label">{step.label}</span>
              <span class="step-tech font-mono">{step.tech}</span>
              {step.now && <span class="step-badge">{t('home.path.now')}</span>}
            </li>
          ))
        }
      </ol>
      <p class="tile-growth">{profile.headline[lang]}</p>
      <a class="card-link tile-more" href={getAlternatePath(lang, 'about')}>
        {t('home.tile.profileMore')}<span aria-hidden="true"> →</span>
      </a>
    </div>

    <div class="tile panel tile-work" style="view-transition-name: tile-work">
      <h2 class="tile-title"><a class="card-link" href={getAlternatePath(lang, 'projects/work')}>{t('projects.tab.work')}</a></h2>
      <MiniCareerGraph careers={careers} />
      <p class="tile-meta">{t('home.tile.work', { n: careers.length, years: formatYears(totalMonths, t) })}</p>
      <span class="tile-arrow" aria-hidden="true">→</span>
    </div>

    <div class="tile panel tile-skills" style="view-transition-name: tile-skills">
      <h2 class="tile-title"><a class="card-link" href={getAlternatePath(lang, 'skills')}>{t('skills.title')}</a></h2>
      <ul class="skill-list">
        {
          featured.map((usage, index) => (
            <li style={`--i: ${index}`}>
              <span class="skill-name">{usage.skill.data.name}</span>
              <span class="skill-usage">{formatUsage(usage, t)}</span>
            </li>
          ))
        }
      </ul>
      <p class="tile-meta">{t('home.tile.skillsHint')}</p>
      <span class="tile-arrow" aria-hidden="true">→</span>
    </div>

    <div class="tile panel tile-personal" style="view-transition-name: tile-personal">
      <h2 class="tile-title">
        <a class="card-link" href={getAlternatePath(lang, 'projects/personal')}>{t('projects.tab.personal')}</a>
        <span class="tile-count">{t('home.card.projects', { n: projects.length })}</span>
      </h2>
      {/* 個人開発の一覧と同じ「ターミナルの小さなウィンドウ」で新しい 2 件を見せる (タイル全体が一覧へのリンク) / 개인 개발 목록과 같은 "터미널의 작은 창"으로 최신 2건을 보여준다 (타일 전체가 목록 링크) */}
      <ul class="mini-windows">
        {
          latestProjects.map((project) => (
            <li class="mini-window">
              <div class="window-bar" aria-hidden="true">
                <span class="dots"><span /><span /><span /></span>
                <span class="window-path font-mono">{`~/projects/${project.id}`}</span>
              </div>
              <div class="window-body">
                <p class="tile-project">{project.data.title[lang]}</p>
                <p class="tile-summary">{project.data.summary[lang]}</p>
                <p class="window-logos">
                  {project.data.tech.slice(0, 5).map((ref) => (
                    <SkillLogo id={ref.id} name={skillNames.get(ref.id) ?? ref.id} size="sm" />
                  ))}
                </p>
              </div>
            </li>
          ))
        }
      </ul>
      <span class="tile-arrow" aria-hidden="true">→</span>
    </div>

    <div class="tile panel tile-contact" style="view-transition-name: tile-contact">
      <h2 class="tile-title"><a class="card-link" href={getAlternatePath(lang, 'contact')}>{t('contact.title')}</a></h2>
      <p class="tile-lead">{t('home.tile.contactLead')}</p>
      <p class="tile-meta font-mono">
        {profile.email && <span>{profile.email}</span>}
        <span>{`github.com/${profile.github}`}</span>
      </p>
      <span class="tile-arrow" aria-hidden="true">→</span>
    </div>
  </div>
</BaseLayout>

<style>
  /* ---- 配置: スマートフォンは縦に積み、PC は 1 画面に収める / 배치: 스마트폰은 세로로 쌓고, PC는 한 화면에 담는다 ---- */
  .bento {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 0.875rem;
  }

  @media (min-width: 48rem) {
    .bento {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .tile-profile,
    .tile-work,
    .tile-contact {
      grid-column: span 2;
    }
  }

  /* 高さが足りない画面では 1 画面に詰めず、縦に伸ばす / 높이가 부족한 화면에서는 한 화면에 채우지 않고 세로로 늘린다 */
  @media (min-width: 64rem) and (min-height: 40rem) {
    .bento {
      height: calc(100dvh - 9rem);
      min-height: 34rem;
      max-height: 52rem;
      grid-template-columns: repeat(4, minmax(0, 1fr));
      grid-template-rows: minmax(0, 1fr) minmax(0, 1fr) minmax(0, 0.62fr);
      grid-template-areas:
        'profile profile work work'
        'profile profile skills personal'
        'contact contact skills personal';
    }

    .tile-profile {
      grid-area: profile;
      padding: 2rem;
    }

    .tile-work {
      grid-area: work;
    }

    .tile-skills {
      grid-area: skills;
    }

    .tile-personal {
      grid-area: personal;
    }

    .tile-contact {
      grid-area: contact;
    }
  }

  /* ---- タイル。全体がリンク (.card-link を面いっぱいに広げる) / 타일. 전체가 링크 (.card-link를 면 전체로 넓힌다) ---- */
  .tile {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    min-width: 0;
    padding: 1.25rem;
    overflow: hidden;
  }

  .tile:has(.card-link:hover) {
    border-color: var(--accent);
  }

  .tile:has(.card-link:focus-visible) {
    outline: var(--focus-ring);
    outline-offset: 3px;
  }

  .tile .card-link {
    color: var(--text);
    text-decoration: none;
  }

  .tile-title {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: 0 1rem;
    padding-right: 2rem;
    font-size: 1rem;
  }

  .tile-count {
    white-space: nowrap;
    font-size: 0.875rem;
    font-weight: 400;
    color: var(--muted);
  }

  .tile-arrow {
    position: absolute;
    top: 1.125rem;
    right: 1.25rem;
    color: var(--accent);
    font-size: 1.25rem;
  }

  .tile-meta {
    margin-top: auto;
    display: flex;
    flex-wrap: wrap;
    gap: 0.25rem 1rem;
    font-size: 0.8125rem;
    color: var(--muted);
    overflow-wrap: anywhere;
  }

  /* ---- プロフィール / 프로필 ---- */
  .tile-prompt {
    font-size: 0.8125rem;
    font-weight: 700;
    color: var(--muted);
  }

  .tile-name {
    font-size: clamp(2rem, 1.3rem + 2.8vw, 3.25rem);
    line-height: 1.15;
    letter-spacing: 0.02em;
  }

  .tile-role {
    color: var(--muted);
  }

  /* ---- 成長の流れ (矢印は装飾として読み上げない) / 성장 경로 (화살표는 장식으로 읽지 않는다) ---- */
  .path {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 1.75rem;
    margin-block: 1.5rem 1.25rem;
  }

  .step {
    position: relative;
    display: grid;
    align-content: start;
    gap: 0.125rem;
    padding: 0.75rem 0.875rem;
    border: 1px solid var(--control-border);
    border-radius: 10px;
    background: var(--bg);
  }

  .step:not(:last-child)::after {
    content: '→' / '';
    position: absolute;
    top: 50%;
    right: -1.375rem;
    color: var(--accent);
    transform: translateY(-50%);
  }

  .step-label {
    font-weight: 700;
    line-height: 1.4;
  }

  .step-tech {
    font-size: 0.75rem;
    color: var(--muted);
    overflow-wrap: anywhere;
  }

  /* いま挑戦中の段階は点線と文字のバッジで示す (色だけに頼らない) / 지금 도전 중인 단계는 점선과 글자 배지로 표시한다 (색에만 의존하지 않는다) */
  .step-now {
    border-style: dashed;
    border-color: var(--accent);
    background: var(--surface);
  }

  .step-badge {
    justify-self: start;
    margin-top: 0.25rem;
    padding: 0 0.5rem;
    border: 1px solid var(--accent);
    border-radius: 999px;
    font-size: 0.6875rem;
    color: var(--accent);
  }

  @media (max-width: 30rem) {
    .path {
      gap: 1rem;
    }

    .step {
      padding: 0.5rem;
      font-size: 0.75rem;
    }

    .step-tech {
      font-size: 0.6875rem;
    }

    .step:not(:last-child)::after {
      right: -0.875rem;
    }
  }

  /* 中心のメッセージ (バックエンドからクラウドを含むフルスタックへ) / 핵심 메시지 (백엔드에서 클라우드를 포함한 풀스택으로) */
  .tile-growth {
    margin-top: auto;
    padding-left: 0.875rem;
    border-left: 3px solid var(--accent);
    font-size: clamp(1rem, 0.9rem + 0.5vw, 1.25rem);
  }

  .tile-profile .card-link {
    margin-top: 0.75rem;
    color: var(--accent);
    font-weight: 700;
    font-size: 0.9375rem;
  }

  .tile-profile:has(.card-link:hover) .card-link {
    text-decoration: underline;
  }

  /* ---- スキル / 스킬 ---- */
  .skill-list {
    display: grid;
    margin-top: 0.25rem;
  }

  .skill-list li {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 0.5rem;
    padding-block: 0.5rem;
    border-bottom: 1px solid var(--border);
    font-size: 0.9375rem;
  }

  .skill-name {
    font-weight: 700;
  }

  .skill-usage {
    font-size: 0.8125rem;
    color: var(--muted);
    white-space: nowrap;
  }

  /* ---- 個人開発 (一覧と同じウィンドウ型) / 개인 개발 (목록과 같은 창 모양) ---- */
  .mini-windows {
    display: grid;
    gap: 0.625rem;
  }

  .mini-window {
    overflow: hidden;
    border: 1px solid var(--border);
    border-radius: 10px;
    background: var(--bg);
  }

  .window-bar {
    display: flex;
    align-items: center;
    gap: 0.625rem;
    padding: 0.375rem 0.75rem;
    background: #15161c;
    color: #a3a19a;
  }

  .dots {
    display: flex;
    flex: none;
    gap: 0.25rem;
  }

  .dots span {
    width: 0.4375rem;
    height: 0.4375rem;
    border-radius: 50%;
    background: #3a3b48;
  }

  .window-path {
    overflow: hidden;
    font-size: 0.6875rem;
    white-space: nowrap;
    text-overflow: ellipsis;
  }

  .window-body {
    display: grid;
    gap: 0.25rem;
    padding: 0.625rem 0.75rem 0.75rem;
  }

  .window-logos {
    display: flex;
    flex-wrap: wrap;
    gap: 0.25rem;
    margin-top: 0.25rem;
  }

  .tile-project {
    font-weight: 700;
    line-height: 1.5;
  }

  .tile-summary {
    display: -webkit-box;
    overflow: hidden;
    font-size: 0.875rem;
    line-height: 1.6;
    color: var(--muted);
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 2;
  }

  /* ---- お問い合わせ / 문의 ---- */
  .tile-lead {
    font-weight: 700;
  }

  /* ---- 動き (transform だけ。動きを減らす設定では付けない) / 움직임 (transform만. 동작 줄이기 설정에서는 넣지 않는다) ---- */
  @media (prefers-reduced-motion: no-preference) {
    .tile {
      transition:
        transform 200ms ease,
        border-color 150ms ease;
    }

    .tile:has(.card-link:hover) {
      transform: translateY(-3px);
    }

    /* 成長の流れが左から順に現れる (位置だけ動かす) / 성장 경로가 왼쪽부터 차례로 나타난다 (위치만 움직인다) */
    .step {
      animation: slide-in 500ms cubic-bezier(0.2, 0.8, 0.2, 1) both;
      animation-delay: calc(var(--i) * 120ms + 200ms);
    }

    /* 代表スキルが上から順に現れる (位置だけ動かす) / 대표 스킬이 위에서부터 차례로 나타난다 (위치만 움직인다) */
    .skill-list li {
      animation: slide-in 500ms cubic-bezier(0.2, 0.8, 0.2, 1) both;
      animation-delay: calc(var(--i) * 70ms + 150ms);
    }
  }

  @keyframes slide-in {
    from {
      transform: translateX(-0.75rem);
    }
  }
</style>
