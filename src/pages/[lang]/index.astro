---
import MiniCareerGraph from '../../components/MiniCareerGraph.astro';
import ProjectCover from '../../components/ProjectCover.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getAlternatePath, getLangStaticPaths, toLang, useTranslations } from '../../i18n/utils';
import {
  formatUsage,
  formatYears,
  getCareers,
  getProfile,
  getProjects,
  getSkillsWithUsage,
  getTotalCareerMonths,
} from '../../lib/content';

export function getStaticPaths() {
  return getLangStaticPaths();
}

const lang = toLang(Astro.params.lang);
const t = useTranslations(lang);

const [profile, careers, projects, skills, totalMonths] = await Promise.all([
  getProfile(),
  getCareers(),
  getProjects(),
  getSkillsWithUsage(),
  getTotalCareerMonths(),
]);

const featured = skills.filter(({ skill }) => skill.data.featured);
const latestProject = projects[0];
const growth = profile.growth[0]?.[lang];
---

<BaseLayout lang={lang} description={t('home.description')} home>
  {/*
    各ページの入口をタイルで並べる。タイルとページ見出しは同じ view-transition-name を持ち、押すとタイルが広がってページになる (ADR 0007)
    각 페이지 입구를 타일로 배치한다. 타일과 페이지 제목은 같은 view-transition-name을 가져, 누르면 타일이 넓어져 페이지가 된다 (ADR 0007)
  */}
  <div class="bento">
    <div class="tile panel tile-profile" style="view-transition-name: tile-profile">
      <p class="tile-prompt font-mono" aria-hidden="true">~/whoami</p>
      <h1 class="tile-name">{profile.displayName}</h1>
      <p class="tile-role">{profile.title[lang]}</p>
      {/* 要約の値はすべてコンテンツから計算する / 요약 값은 모두 콘텐츠에서 계산한다 */}
      <dl class="tile-facts">
        <div>
          <dt>{t('profile.experience')}</dt>
          <dd>{formatYears(totalMonths, t)}</dd>
        </div>
        <div>
          <dt>{t('profile.location')}</dt>
          <dd>{profile.location[lang]}</dd>
        </div>
        <div>
          <dt>{t('profile.languages')}</dt>
          <dd>{profile.languages.map((language) => language.name[lang]).join(' / ')}</dd>
        </div>
      </dl>
      {growth && <p class="tile-growth">{growth}</p>}
      <a class="card-link tile-more" href={getAlternatePath(lang, 'about')}>
        {t('home.tile.profileMore')}<span aria-hidden="true"> →</span>
      </a>
    </div>

    <div class="tile panel tile-work" style="view-transition-name: tile-work">
      <h2 class="tile-title"><a class="card-link" href={getAlternatePath(lang, 'projects/work')}>{t('projects.tab.work')}</a></h2>
      <MiniCareerGraph careers={careers} />
      <p class="tile-meta">{t('home.tile.work', { n: careers.length, years: formatYears(totalMonths, t) })}</p>
      <span class="tile-arrow" aria-hidden="true">→</span>
    </div>

    <div class="tile panel tile-skills" style="view-transition-name: tile-skills">
      <h2 class="tile-title"><a class="card-link" href={getAlternatePath(lang, 'skills')}>{t('skills.title')}</a></h2>
      <ul class="skill-list">
        {
          featured.map((usage, index) => (
            <li style={`--i: ${index}`}>
              <span class="skill-name">{usage.skill.data.name}</span>
              <span class="skill-usage">{formatUsage(usage, t)}</span>
            </li>
          ))
        }
      </ul>
      <p class="tile-meta">{t('home.tile.skillsHint')}</p>
      <span class="tile-arrow" aria-hidden="true">→</span>
    </div>

    <div class="tile panel tile-personal" style="view-transition-name: tile-personal">
      <h2 class="tile-title">
        <a class="card-link" href={getAlternatePath(lang, 'projects/personal')}>{t('projects.tab.personal')}</a>
        <span class="tile-count">{t('home.card.projects', { n: projects.length })}</span>
      </h2>
      {
        latestProject && (
          <>
            <div class="tile-cover">
              <ProjectCover project={latestProject} lang={lang} />
            </div>
            <p class="tile-project">{latestProject.data.title[lang]}</p>
            <p class="tile-summary">{latestProject.data.summary[lang]}</p>
          </>
        )
      }
      <span class="tile-arrow" aria-hidden="true">→</span>
    </div>

    <div class="tile panel tile-contact" style="view-transition-name: tile-contact">
      <h2 class="tile-title"><a class="card-link" href={getAlternatePath(lang, 'contact')}>{t('contact.title')}</a></h2>
      <p class="tile-lead">{t('home.tile.contactLead')}</p>
      <p class="tile-meta font-mono">
        {profile.email && <span>{profile.email}</span>}
        <span>{`github.com/${profile.github}`}</span>
      </p>
      <span class="tile-arrow" aria-hidden="true">→</span>
    </div>
  </div>
</BaseLayout>

<style>
  /* ---- 配置: スマートフォンは縦に積み、PC は 1 画面に収める / 배치: 스마트폰은 세로로 쌓고, PC는 한 화면에 담는다 ---- */
  .bento {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 0.875rem;
  }

  @media (min-width: 48rem) {
    .bento {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .tile-profile,
    .tile-work,
    .tile-contact {
      grid-column: span 2;
    }
  }

  /* 高さが足りない画面では 1 画面に詰めず、縦に伸ばす / 높이가 부족한 화면에서는 한 화면에 채우지 않고 세로로 늘린다 */
  @media (min-width: 64rem) and (min-height: 40rem) {
    .bento {
      height: calc(100dvh - 9rem);
      min-height: 34rem;
      max-height: 52rem;
      grid-template-columns: repeat(4, minmax(0, 1fr));
      grid-template-rows: minmax(0, 1fr) minmax(0, 1fr) minmax(0, 0.62fr);
      grid-template-areas:
        'profile profile work work'
        'profile profile skills personal'
        'contact contact skills personal';
    }

    .tile-profile {
      grid-area: profile;
      padding: 2rem;
    }

    .tile-work {
      grid-area: work;
    }

    .tile-skills {
      grid-area: skills;
    }

    .tile-personal {
      grid-area: personal;
    }

    .tile-contact {
      grid-area: contact;
    }
  }

  /* ---- タイル。全体がリンク (.card-link を面いっぱいに広げる) / 타일. 전체가 링크 (.card-link를 면 전체로 넓힌다) ---- */
  .tile {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    min-width: 0;
    padding: 1.25rem;
    overflow: hidden;
  }

  .tile:has(.card-link:hover) {
    border-color: var(--accent);
  }

  .tile:has(.card-link:focus-visible) {
    outline: var(--focus-ring);
    outline-offset: 3px;
  }

  .tile .card-link {
    color: var(--text);
    text-decoration: none;
  }

  .tile-title {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: 0 1rem;
    padding-right: 2rem;
    font-size: 1rem;
  }

  .tile-count {
    white-space: nowrap;
    font-size: 0.875rem;
    font-weight: 400;
    color: var(--muted);
  }

  .tile-arrow {
    position: absolute;
    top: 1.125rem;
    right: 1.25rem;
    color: var(--accent);
    font-size: 1.25rem;
  }

  .tile-meta {
    margin-top: auto;
    display: flex;
    flex-wrap: wrap;
    gap: 0.25rem 1rem;
    font-size: 0.8125rem;
    color: var(--muted);
    overflow-wrap: anywhere;
  }

  /* ---- プロフィール / 프로필 ---- */
  .tile-prompt {
    font-size: 0.8125rem;
    font-weight: 700;
    color: var(--muted);
  }

  .tile-name {
    font-size: clamp(2rem, 1.3rem + 2.8vw, 3.25rem);
    line-height: 1.15;
    letter-spacing: 0.02em;
  }

  .tile-role {
    color: var(--muted);
  }

  .tile-facts {
    display: grid;
    gap: 0.25rem;
    margin-top: 0.75rem;
    font-size: 0.875rem;
  }

  .tile-facts div {
    display: grid;
    grid-template-columns: 6rem minmax(0, 1fr);
    gap: 0.75rem;
  }

  .tile-facts dt {
    font-family: var(--font-mono);
    color: var(--muted);
  }

  /* 中心のメッセージ (バックエンドからクラウドを含むフルスタックへ) / 핵심 메시지 (백엔드에서 클라우드를 포함한 풀스택으로) */
  .tile-growth {
    margin-top: auto;
    padding-left: 0.875rem;
    border-left: 3px solid var(--accent);
    font-size: clamp(1rem, 0.9rem + 0.5vw, 1.25rem);
  }

  .tile-profile .card-link {
    margin-top: 0.75rem;
    color: var(--accent);
    font-weight: 700;
    font-size: 0.9375rem;
  }

  .tile-profile:has(.card-link:hover) .card-link {
    text-decoration: underline;
  }

  /* ---- スキル / 스킬 ---- */
  .skill-list {
    display: grid;
    margin-top: 0.25rem;
  }

  .skill-list li {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 0.5rem;
    padding-block: 0.5rem;
    border-bottom: 1px solid var(--border);
    font-size: 0.9375rem;
  }

  .skill-name {
    font-weight: 700;
  }

  .skill-usage {
    font-size: 0.8125rem;
    color: var(--muted);
    white-space: nowrap;
  }

  /* ---- 個人開発 / 개인 개발 ---- */
  .tile-cover {
    overflow: hidden;
    border: 1px solid var(--border);
    border-radius: 10px;
  }

  .tile-cover :global(.cover-path) {
    font-size: 0.9375rem;
  }

  .tile-project {
    margin-top: 0.25rem;
    font-weight: 700;
    line-height: 1.5;
  }

  .tile-summary {
    display: -webkit-box;
    overflow: hidden;
    font-size: 0.875rem;
    line-height: 1.6;
    color: var(--muted);
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 2;
  }

  /* PC では表紙をタイルの残りの高さに合わせる / PC에서는 표지를 타일의 남은 높이에 맞춘다 */
  @media (min-width: 64rem) and (min-height: 40rem) {
    .tile-cover {
      flex: 1;
      min-height: 0;
    }

    .tile-cover :global(.cover) {
      height: 100%;
      aspect-ratio: auto;
      border-bottom: 0;
    }
  }

  /* ---- お問い合わせ / 문의 ---- */
  .tile-lead {
    font-weight: 700;
  }

  /* ---- 動き (transform だけ。動きを減らす設定では付けない) / 움직임 (transform만. 동작 줄이기 설정에서는 넣지 않는다) ---- */
  @media (prefers-reduced-motion: no-preference) {
    .tile {
      transition:
        transform 200ms ease,
        border-color 150ms ease;
    }

    .tile:has(.card-link:hover) {
      transform: translateY(-3px);
    }

    /* 代表スキルが上から順に現れる (位置だけ動かす) / 대표 스킬이 위에서부터 차례로 나타난다 (위치만 움직인다) */
    .skill-list li {
      animation: slide-in 500ms cubic-bezier(0.2, 0.8, 0.2, 1) both;
      animation-delay: calc(var(--i) * 70ms + 150ms);
    }
  }

  @keyframes slide-in {
    from {
      transform: translateX(-0.75rem);
    }
  }
</style>
