---
import Section from '../../../../components/Section.astro';
import BaseLayout from '../../../../layouts/BaseLayout.astro';
import { locales } from '../../../../i18n/config';
import { getAlternatePath, toLang, useTranslations } from '../../../../i18n/utils';
import { formatYearMonth, getProjects, hasDetailPage, type Project } from '../../../../lib/content';
import { sortPhases } from '../../../../lib/phases';

// 概要がある個人開発だけ詳細ページを作る / 개요가 있는 개인 개발만 상세 페이지를 만든다
export async function getStaticPaths() {
  const projects = (await getProjects()).filter(hasDetailPage);
  return locales.flatMap((lang) => projects.map((project) => ({ params: { lang, slug: project.id }, props: { project } })));
}

interface Props {
  project: Project;
}

const { project } = Astro.props;
const { data } = project;
const lang = toLang(Astro.params.lang);
const t = useTranslations(lang);
// リンク欄は公開先 (デモ)・Zenn だけ。GitHub のリポジトリは載せない / 링크 칸은 공개 주소 (데모)·Zenn만. GitHub 리포지토리는 싣지 않는다
// 概要のすぐ後 (02) に置き、動くものを先に見せる / 개요 바로 뒤 (02)에 두어, 동작하는 것을 먼저 보여준다
const links = [
  ...(data.demo ? [{ kind: 'demo' as const, url: data.demo }] : []),
  ...(data.zenn ? [{ kind: 'zenn' as const, url: data.zenn }] : []),
];

// データがある項目だけを表示し、番号は表示した順に振る / 데이터가 있는 항목만 표시하고, 번호는 표시한 순서대로 매긴다
let sectionNumber = 0;
const next = () => ++sectionNumber;
---

<BaseLayout lang={lang} title={data.title[lang]} description={data.summary[lang]}>
  <p class="mb-6 text-sm">
    <a class="tap" href={getAlternatePath(lang, 'projects/personal')}>{`← ${t('projects.backToList')}`}</a>
  </p>
  <h1 class="text-title">{data.title[lang]}</h1>
  <p class="mt-3 max-w-[var(--measure)] text-muted">{data.summary[lang]}</p>

  {/* メタ情報は固定幅フォントのキー・値で示す (仕様書型の要素) / 메타 정보는 고정폭 글꼴의 키·값으로 표시한다 (사양서형 요소) */}
  <dl class="meta mt-8 mb-10">
    <div>
      <dt>{t('project.meta.type')}</dt>
      <dd class="font-mono">{`${t(`project.category.${data.category}`)} / ${t(`project.status.${data.status}`)}`}</dd>
    </div>
    {
      data.start && (
        <div>
          <dt>{t('project.meta.period')}</dt>
          <dd class="font-mono">
            <time datetime={data.start}>{formatYearMonth(data.start, lang)}</time>
            {/* 開始と終了が同じ月なら 1 回だけ書く / 시작과 종료가 같은 달이면 한 번만 쓴다 */}
            {data.end !== data.start && (
              <>
                {' – '}
                {data.end ? <time datetime={data.end}>{formatYearMonth(data.end, lang)}</time> : t('period.present')}
              </>
            )}
            {data.duration && (
              <span class="text-muted">{lang === 'ja' || lang === 'zh' ? `（${data.duration[lang]}）` : ` (${data.duration[lang]})`}</span>
            )}
          </dd>
        </div>
      )
    }
    {
      data.stack.length > 0 && (
        <div>
          <dt>{t('project.meta.stack')}</dt>
          <dd class="font-mono">{data.stack.map((item) => item.name).join(' / ')}</dd>
        </div>
      )
    }
  </dl>

  {
    data.overview.length > 0 && (
      <Section index={next()} label={t('project.section.overview')} id="overview">
        <div class="space-y-4">
          {data.overview.map((paragraph) => (
            <p>{paragraph[lang]}</p>
          ))}
        </div>
      </Section>
    )
  }

  {
    links.length > 0 && (
      <Section index={next()} label={t('project.section.links')} id="links">
        <dl class="kv">
          {links.map((link) => (
            <div>
              <dt>{t(`project.link.${link.kind}`)}</dt>
              <dd>
                {/* サイトの外は新しいタブで開き、読み上げでもそれを伝える / 사이트 밖은 새 탭에서 열고, 스크린리더에도 그것을 알린다 */}
                <a class="tap font-mono" href={link.url} target="_blank" rel="noopener noreferrer">
                  {link.url.replace(/^https:\/\//, '').replace(/\/$/, '')}
                  <span class="sr-only">{t('link.newTab')}</span>
                </a>
              </dd>
            </div>
          ))}
        </dl>
      </Section>
    )
  }

  {
    (data.video || data.screenshots.length > 0) && (
      <Section index={next()} label={t('project.section.media')} id="media">
        {/* 縦長の画面は横に並べてスクロールさせ、ページが長くなりすぎないようにする / 세로로 긴 화면은 가로로 늘어놓고 스크롤해, 페이지가 너무 길어지지 않게 한다 */}
        <ul class="media-strip" tabindex="0" aria-label={t('project.section.media')}>
          {data.video && (
            <li>
              {/* 自動再生しない (動きを減らす設定・通信量への配慮) / 자동 재생하지 않는다 (동작 줄이기 설정·데이터 사용량 배려) */}
              <video
                src={data.video.src}
                poster={data.video.poster}
                width={data.video.width}
                height={data.video.height}
                controls
                muted
                playsinline
                preload="none"
                aria-label={data.video.label[lang]}
              />
            </li>
          )}
          {data.screenshots.map((shot) => (
            <li>
              <img src={shot.src} alt={shot.alt[lang]} width={shot.width} height={shot.height} loading="lazy" decoding="async" />
            </li>
          ))}
        </ul>
      </Section>
    )
  }

  {
    data.diagram && (
      <Section index={next()} label={t('project.section.diagram')} id="diagram">
        <img src={data.diagram.src} alt={data.diagram.alt[lang]} loading="lazy" decoding="async" />
      </Section>
    )
  }

  {
    data.stack.length > 0 && (
      <Section index={next()} label={t('project.section.stack')} id="stack">
        <dl class="meta">
          {data.stack.map((item) => (
            <div>
              <dt>{item.name}</dt>
              <dd>
                {item.version && <span class="font-mono">{item.version}</span>}
                {item.purpose && <span class="meta-note">{item.purpose[lang]}</span>}
              </dd>
            </div>
          ))}
        </dl>
      </Section>
    )
  }

  {
    data.decisions.length > 0 && (
      <Section index={next()} label={t('project.section.decisions')} id="decisions">
        <div class="space-y-8">
          {data.decisions.map((decision) => (
            <article class="space-y-2">
              <h3 class="font-bold">{decision.topic[lang]}</h3>
              <dl class="kv">
                <div>
                  <dt>{t('project.decision.reason')}</dt>
                  <dd>{decision.reason[lang]}</dd>
                </div>
                {decision.alternatives && (
                  <div>
                    <dt>{t('project.decision.alternatives')}</dt>
                    <dd>{decision.alternatives[lang]}</dd>
                  </div>
                )}
              </dl>
              {decision.adr && (
                <p class="text-sm">
                  <a class="tap" href={decision.adr} target="_blank" rel="noopener noreferrer">
                    {t('project.decision.adr')}
                    <span class="sr-only">{t('link.newTab')}</span>
                  </a>
                </p>
              )}
            </article>
          ))}
        </div>
      </Section>
    )
  }

  {
    data.phases.length > 0 && (
      <Section index={next()} label={t('project.section.phases')} id="phases">
        <p>{sortPhases(data.phases).map((phase) => t(`phase.${phase}`)).join(' / ')}</p>
      </Section>
    )
  }

  {
    data.challenges.length > 0 && (
      <Section index={next()} label={t('project.section.challenges')} id="challenges">
        <ol class="space-y-8">
          {data.challenges.map((challenge) => (
            <li>
              <dl class="kv">
                <div>
                  <dt>{t('project.challenge.problem')}</dt>
                  <dd>{challenge.problem[lang]}</dd>
                </div>
                <div>
                  <dt>{t('project.challenge.solution')}</dt>
                  <dd>{challenge.solution[lang]}</dd>
                </div>
              </dl>
            </li>
          ))}
        </ol>
      </Section>
    )
  }

</BaseLayout>

<style>
  /* 仕様書型のメタ情報: 固定幅フォントのキー・値 / 사양서형 메타 정보: 고정폭 글꼴의 키·값 */
  .meta {
    display: grid;
    gap: 0.5rem;
    font-size: 0.875rem;
  }

  .meta > div {
    display: grid;
    grid-template-columns: 7rem minmax(0, 1fr);
    gap: 1rem;
  }

  .meta dt {
    font-family: var(--font-mono);
    color: var(--muted);
  }

  .meta dd {
    overflow-wrap: anywhere;
  }

  .meta-note {
    display: block;
    color: var(--muted);
  }

  @media (min-width: 48rem) {
    .meta > div {
      grid-template-columns: 11rem minmax(0, 1fr);
      gap: 2rem;
    }
  }
  .media-strip {
    display: flex;
    gap: 1rem;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    padding-bottom: 0.75rem;
    border-radius: var(--radius);
  }

  .media-strip:focus-visible {
    outline: var(--focus-ring);
    outline-offset: 4px;
  }

  .media-strip > li {
    flex: 0 0 auto;
    width: min(60vw, 15rem);
    scroll-snap-align: start;
  }

  .media-strip img,
  .media-strip video {
    display: block;
    width: 100%;
    height: auto;
    border: 1px solid var(--border);
    border-radius: var(--radius);
    background: #15161c;
  }
</style>
