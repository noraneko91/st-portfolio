---
import PageHero from '../../../../components/PageHero.astro';
import ProjectTabs from '../../../../components/ProjectTabs.astro';
import SkillLogo from '../../../../components/SkillLogo.astro';
import BaseLayout from '../../../../layouts/BaseLayout.astro';
import { getAlternatePath, getLangStaticPaths, toLang, useTranslations } from '../../../../i18n/utils';
import { formatYearMonth, getProjects, getSkillNames, hasDetailPage } from '../../../../lib/content';

export function getStaticPaths() {
  return getLangStaticPaths();
}

const lang = toLang(Astro.params.lang);
const t = useTranslations(lang);
const [projects, skillNames] = await Promise.all([getProjects(), getSkillNames()]);
---

<BaseLayout lang={lang} title={t('projects.tab.personal')} description={t('projects.personal.description')}>
  <PageHero tile="personal" icon="board">
    <h1 class="text-title mb-3">{t('projects.title')}</h1>
    <p class="max-w-[var(--measure)] text-muted">{t('projects.personal.description')}</p>
  </PageHero>
  <ProjectTabs lang={lang} current="personal" />

  {/*
    各プロジェクトをターミナルの小さなウィンドウに見立てる (About のターミナルと同じ雰囲気)。大きな表紙はやめて一覧を詰める
    각 프로젝트를 터미널의 작은 창에 빗댄다 (About 터미널과 같은 분위기). 큰 표지는 없애고 목록을 촘촘하게 한다
  */}
  <ul class="project-grid">
    {
      projects.map((project) => {
        const { data } = project;
        // 詳細ページがあればそこへ、なければ GitHub へ / 상세 페이지가 있으면 그곳으로, 없으면 GitHub로
        const href = hasDetailPage(project) ? getAlternatePath(lang, `projects/personal/${project.id}`) : data.github[0];
        return (
          <li class="project panel reveal">
            <div class="window-bar" aria-hidden="true">
              <span class="dots"><span /><span /><span /></span>
              <span class="path font-mono">{`~/projects/${project.id}`}</span>
            </div>
            {data.thumbnail && (
              <img class="thumb" src={data.thumbnail.src} alt={data.thumbnail.alt[lang]} width="1200" height="675" loading="lazy" decoding="async" />
            )}
            <div class="project-body">
              <p class="project-meta font-mono">
                <span class="badge">{t(`project.category.${data.category}`)}</span>
                <span class:list={['badge', { 'badge-active': data.status === 'in-progress' }]}>
                  {t(`project.status.${data.status}`)}
                </span>
                <time datetime={data.start}>{formatYearMonth(data.start, lang)}</time>
              </p>
              <h2 class="project-title">
                <a class="card-link" href={href} data-no-ext>
                  {data.title[lang]}
                </a>
                <span class="project-arrow" aria-hidden="true">
                  {hasDetailPage(project) ? '→' : '↗'}
                </span>
              </h2>
              <p class="project-summary">{data.summary[lang]}</p>
              {data.tech.length > 0 && (
                <ul class="chips">
                  {data.tech.map((ref) => {
                    const name = skillNames.get(ref.id) ?? ref.id;
                    return (
                      <li>
                        <SkillLogo id={ref.id} name={name} size="sm" />
                        {name}
                      </li>
                    );
                  })}
                </ul>
              )}
            </div>
          </li>
        );
      })
    }
  </ul>
</BaseLayout>

<style>
  .project-grid {
    display: grid;
    gap: 1rem;
  }

  @media (min-width: 48rem) {
    .project-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (min-width: 72rem) {
    .project-grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }

  .project {
    display: flex;
    flex-direction: column;
    overflow: hidden;
  }

  /* カード全体がリンク。枠と矢印で押せることを示し、フォーカス枠はカードに出す / 카드 전체가 링크. 테두리와 화살표로 누를 수 있음을 보여주고, 포커스 테두리는 카드에 표시한다 */
  .project:has(.card-link:hover) {
    border-color: var(--accent);
  }

  .project:has(.card-link:focus-visible) {
    outline: var(--focus-ring);
    outline-offset: 3px;
  }

  .card-link:focus-visible {
    outline: none;
  }

  /* ---- ウィンドウのタイトルバー (ライト・ダークとも暗い配色) / 창 제목 표시줄 (라이트·다크 모두 어두운 색) ---- */
  .window-bar {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    padding: 0.5rem 0.875rem;
    background: #15161c;
    color: #a3a19a;
  }

  .dots {
    display: flex;
    flex: none;
    gap: 0.3125rem;
  }

  .dots span {
    width: 0.5rem;
    height: 0.5rem;
    border-radius: 50%;
    background: #3a3b48;
  }

  .path {
    overflow: hidden;
    font-size: 0.75rem;
    white-space: nowrap;
    text-overflow: ellipsis;
  }

  .thumb {
    width: 100%;
    height: auto;
    aspect-ratio: 16 / 9;
    object-fit: cover;
    border-bottom: 1px solid var(--border);
  }

  .project-body {
    display: flex;
    flex: 1;
    flex-direction: column;
    gap: 0.5rem;
    padding: 1rem 1.125rem 1.125rem;
  }

  .project-meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.375rem 0.5rem;
    font-size: 0.6875rem;
    color: var(--muted);
  }

  .badge {
    padding: 0 0.5rem;
    border: 1px solid var(--border);
    border-radius: 999px;
  }

  /* 進行中は枠をテーマ色に (文字でも状態を示している) / 진행 중은 테두리를 포인트 컬러로 (글자로도 상태를 표시한다) */
  .badge-active {
    border-color: var(--accent);
    color: var(--accent);
  }

  .project-title {
    display: flex;
    align-items: baseline;
    gap: 0.75rem;
    font-size: 1.0625rem;
    line-height: 1.45;
  }

  .project-title .card-link {
    color: var(--text);
    text-decoration: none;
  }

  .project:has(.card-link:hover) .card-link {
    text-decoration: underline;
    text-decoration-color: var(--accent);
  }

  .project-arrow {
    margin-inline-start: auto;
    color: var(--accent);
  }

  .project-summary {
    display: -webkit-box;
    overflow: hidden;
    font-size: 0.875rem;
    line-height: 1.65;
    color: var(--muted);
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 3;
  }

  /* 技術はロゴ付きの小さなチップ。カードの下端にそろえる / 기술은 로고가 붙은 작은 칩. 카드 아래 끝에 맞춘다 */
  .chips {
    display: flex;
    flex-wrap: wrap;
    gap: 0.375rem;
    margin-top: auto;
    padding-top: 0.375rem;
  }

  .chips li {
    display: inline-flex;
    align-items: center;
    gap: 0.375rem;
    padding: 0.125rem 0.5rem 0.125rem 0.1875rem;
    border: 1px solid var(--border);
    border-radius: 999px;
    font-size: 0.75rem;
  }

  @media (prefers-reduced-motion: no-preference) {
    .project {
      transition:
        transform 200ms ease,
        border-color 150ms ease;
    }

    .project:has(.card-link:hover) {
      transform: translateY(-3px);
    }

    .project-arrow {
      transition: transform 200ms ease;
    }

    .project:has(.card-link:hover) .project-arrow {
      transform: translateX(3px);
    }
  }
</style>
