---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { getAlternatePath, getLangStaticPaths, toLang, useTranslations } from '../../../i18n/utils';
import { getProjects } from '../../../lib/content';

export function getStaticPaths() {
  return getLangStaticPaths();
}

const lang = toLang(Astro.params.lang);
const t = useTranslations(lang);
const projects = await getProjects();
---

<BaseLayout lang={lang} title={t('projects.title')} description={t('projects.description')}>
  <h1 class="text-title mb-10">{t('projects.title')}</h1>

  <ul class="project-list">
    {
      projects.map(({ id, data }) =>
        data.status === 'published' ? (
          // リンクはタイトルだけに置き、カード全体に広げる (読み上げはタイトルのみ) / 링크는 제목에만 두고 카드 전체로 넓힌다 (읽기는 제목만)
          <li class="project card reveal">
            <h2 class="project-title">
              <a class="card-link" href={getAlternatePath(lang, `projects/${id}`)}>
                {data.title[lang]}
              </a>
            </h2>
            <p class="project-summary">{data.summary[lang]}</p>
            {data.stack.length > 0 && <p class="project-stack font-mono">{data.stack.map((item) => item.name).join(' / ')}</p>}
            <span class="project-arrow" aria-hidden="true">
              →
            </span>
          </li>
        ) : (
          // 準備中は詳細ページがないためリンクにせず、点線のカードで区別する / 준비 중은 상세 페이지가 없어서 링크로 만들지 않고 점선 카드로 구분한다
          <li class="project card-disabled reveal">
            <h2 class="project-title">
              {data.title[lang]}
              <span class="project-badge">{t('projects.status.wip')}</span>
            </h2>
            <p class="project-summary">{data.summary[lang]}</p>
            {data.stack.length > 0 && <p class="project-stack font-mono">{data.stack.map((item) => item.name).join(' / ')}</p>}
          </li>
        ),
      )
    }
  </ul>
</BaseLayout>

<style>
  .project-list {
    display: grid;
    gap: 1rem;
    max-width: 48rem;
  }

  .project {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    column-gap: 1rem;
    row-gap: 0.375rem;
    padding: 1.25rem;
  }

  .project > :not(.project-arrow) {
    grid-column: 1;
  }

  .project-title {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.5rem 0.75rem;
    font-size: 1.25rem;
    line-height: 1.45;
  }

  .project-badge {
    padding: 0.125rem 0.5rem;
    border: 1px solid var(--border);
    font-size: 0.75rem;
    font-weight: 500;
    color: var(--muted);
  }

  .project-stack {
    font-size: 0.875rem;
    color: var(--muted);
  }

  .project-arrow {
    grid-column: 2;
    grid-row: 1 / span 3;
    align-self: center;
    font-size: 1.25rem;
    color: var(--accent);
  }

  @media (prefers-reduced-motion: no-preference) {
    .project-arrow {
      transition: transform 150ms ease;
    }

    .project:hover .project-arrow {
      transform: translateX(3px);
    }
  }
</style>
