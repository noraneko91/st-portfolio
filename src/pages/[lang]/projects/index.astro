---
import ProjectCover from '../../../components/ProjectCover.astro';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { getAlternatePath, getLangStaticPaths, toLang, useTranslations } from '../../../i18n/utils';
import { getProjects } from '../../../lib/content';

export function getStaticPaths() {
  return getLangStaticPaths();
}

const lang = toLang(Astro.params.lang);
const t = useTranslations(lang);
const projects = await getProjects();
---

<BaseLayout lang={lang} title={t('projects.title')} description={t('projects.description')}>
  <h1 class="text-title mb-10">{t('projects.title')}</h1>

  <ul class="project-grid">
    {
      projects.map((project) =>
        project.data.status === 'published' ? (
          // リンクはタイトルだけに置き、カード全体に広げる (読み上げはタイトルのみ) / 링크는 제목에만 두고 카드 전체로 넓힌다 (읽기는 제목만)
          <li class="project card lift reveal">
            <ProjectCover project={project} lang={lang} />
            <div class="project-body">
              <h2 class="project-title">
                <a class="card-link" href={getAlternatePath(lang, `projects/${project.id}`)}>
                  {project.data.title[lang]}
                </a>
                <span class="project-arrow" aria-hidden="true">
                  →
                </span>
              </h2>
              <p>{project.data.summary[lang]}</p>
            </div>
          </li>
        ) : (
          // 準備中は詳細ページがないためリンクにせず、点線のカードで区別する / 준비 중은 상세 페이지가 없어서 링크로 만들지 않고 점선 카드로 구분한다
          <li class="project card-disabled reveal">
            <ProjectCover project={project} lang={lang} />
            <div class="project-body">
              <h2 class="project-title">
                {project.data.title[lang]}
                <span class="project-badge">{t('projects.status.wip')}</span>
              </h2>
              <p>{project.data.summary[lang]}</p>
            </div>
          </li>
        ),
      )
    }
  </ul>
</BaseLayout>

<style>
  .project-grid {
    display: grid;
    gap: 1.5rem;
  }

  @media (min-width: 48rem) {
    .project-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  .project {
    overflow: hidden;
    background: var(--bg);
  }

  .project-body {
    display: grid;
    gap: 0.5rem;
    padding: 1.25rem 1.5rem 1.5rem;
  }

  .project-title {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.5rem 0.75rem;
    font-size: 1.25rem;
    line-height: 1.45;
  }

  .project-arrow {
    margin-inline-start: auto;
    color: var(--accent);
  }

  .project-badge {
    padding: 0.125rem 0.5rem;
    border: 1px solid var(--border);
    font-size: 0.75rem;
    font-weight: 500;
    color: var(--muted);
  }

  /* hover で表紙を少し拡大し、矢印を動かす / hover 시 표지를 살짝 확대하고 화살표를 움직인다 */
  @media (prefers-reduced-motion: no-preference) {
    .project :global(.cover-art),
    .project :global(.cover img),
    .project-arrow {
      transition: transform 300ms ease;
    }

    .project.card:hover :global(.cover-art),
    .project.card:hover :global(.cover img) {
      transform: scale(1.03);
    }

    .project.card:hover .project-arrow {
      transform: translateX(3px);
    }
  }
</style>
