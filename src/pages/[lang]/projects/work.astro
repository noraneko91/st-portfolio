---
import CareerGraph from '../../../components/CareerGraph.astro';
import ProjectTabs from '../../../components/ProjectTabs.astro';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { getLangStaticPaths, toLang, useTranslations } from '../../../i18n/utils';
import { getCareers, getSkillNames } from '../../../lib/content';

export function getStaticPaths() {
  return getLangStaticPaths();
}

const lang = toLang(Astro.params.lang);
const t = useTranslations(lang);
const [careers, skillNames] = await Promise.all([getCareers(), getSkillNames()]);
---

<BaseLayout lang={lang} title={t('projects.tab.work')} description={t('projects.work.description')}>
  <h1 class="text-title mb-6">{t('projects.title')}</h1>
  <ProjectTabs lang={lang} current="work" />
  {/* 画面ではタブが見出しの役割を持つため、見出しの階層だけを読み上げ用に補う / 화면에서는 탭이 제목 역할을 하므로 제목 계층만 스크린리더용으로 보충한다 */}
  <h2 class="sr-only">{t('projects.tab.work')}</h2>
  <p class="mb-8 max-w-[var(--measure)] text-muted">{t('projects.work.description')}</p>
  <CareerGraph careers={careers} lang={lang} skillNames={skillNames} />
</BaseLayout>
