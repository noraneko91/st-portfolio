---
import CareerItem from '../../components/CareerItem.astro';
import Section from '../../components/Section.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getLangStaticPaths, toLang, useTranslations } from '../../i18n/utils';
import { formatYearMonth, formatYears, getCareers, getProfile, getSkillNames, getTotalCareerMonths } from '../../lib/content';

export function getStaticPaths() {
  return getLangStaticPaths();
}

const lang = toLang(Astro.params.lang);
const t = useTranslations(lang);

const profile = await getProfile();
const careers = await getCareers();
const skillNames = await getSkillNames();
const totalMonths = await getTotalCareerMonths();
const firstStart = careers.at(-1)?.data.start;
---

<BaseLayout lang={lang} title={t('about.title')} description={t('about.description')}>
  <h1 class="text-title mb-10">{t('about.title')}</h1>

  <Section index={1} label={t('about.section.profile')} id="profile">
    <p class="text-2xl font-bold">{profile.displayName}</p>
    <p class="text-muted">{profile.title[lang]}</p>
    <div class="mt-6 space-y-4">
      {profile.intro.map((paragraph) => <p>{paragraph[lang]}</p>)}
    </div>
    <dl class="kv mt-8">
      <div>
        <dt>{t('profile.experience')}</dt>
        <dd>
          {formatYears(totalMonths, t)}
          {firstStart && <span class="ms-2 text-muted">{t('unit.since', { date: formatYearMonth(firstStart, lang) })}</span>}
        </dd>
      </div>
      <div>
        <dt>{t('profile.location')}</dt>
        <dd>{profile.location[lang]}</dd>
      </div>
      <div>
        <dt>{t('profile.languages')}</dt>
        <dd>
          <ul>
            {
              profile.languages.map((language) => (
                <li>{language.level ? `${language.name[lang]} — ${language.level[lang]}` : language.name[lang]}</li>
              ))
            }
          </ul>
        </dd>
      </div>
    </dl>
  </Section>

  <Section index={2} label={t('about.section.strengths')} id="strengths">
    <ul class="bullets">
      {profile.strengths.map((strength) => <li>{strength[lang]}</li>)}
    </ul>
  </Section>

  {/* 経歴は本文幅に収めず広げ、git log --graph に見立てたタイムラインで目立たせる / 경력은 본문 폭에 가두지 않고 넓혀, git log --graph에 빗댄 타임라인으로 눈에 띄게 한다 */}
  <section class="block" aria-labelledby="career-label">
    <h2 id="career-label" class="block-label">
      <span class="font-mono" aria-hidden="true">03 —</span>
      {t('about.section.career')}
    </h2>
    <p class="graph-command font-mono" aria-hidden="true"><span class="graph-prompt">$</span> git log --graph</p>
    <ol class="graph">
      {
        careers.map((career, index) => (
          <li class="commit reveal">
            <span class="commit-node" aria-hidden="true" />
            <CareerItem
              career={career}
              lang={lang}
              skillNames={skillNames}
              refLabel={index === 0 ? 'HEAD -> main' : index === careers.length - 1 ? 'root' : undefined}
              head={index === 0}
            />
          </li>
        ))
      }
    </ol>
  </section>
</BaseLayout>

<style>
  .graph-command {
    margin-bottom: 1.5rem;
    font-size: 0.875rem;
    color: var(--muted);
  }

  .graph-prompt {
    margin-inline-end: 0.5rem;
    color: var(--accent);
  }

  .graph {
    max-width: 56rem;
  }

  /* 左の線がブランチ、丸がコミット。線は新しいほどテーマ色が濃い / 왼쪽 선이 브랜치, 원이 커밋. 선은 최신일수록 포인트 컬러가 진하다 */
  .commit {
    position: relative;
    padding-inline-start: 2.75rem;
    padding-bottom: 1.5rem;
  }

  .commit::before {
    content: '';
    position: absolute;
    top: 0;
    bottom: 0;
    left: 0.875rem;
    width: 3px;
    background: linear-gradient(var(--accent), var(--control-border));
  }

  .commit:first-child::before {
    top: 1.5rem;
  }

  .commit:last-child {
    padding-bottom: 0;
  }

  .commit:last-child::before {
    bottom: auto;
    height: 1.5rem;
  }

  .commit-node {
    position: absolute;
    top: 1.0625rem;
    left: 0.4375rem;
    z-index: 1;
    width: 1.125rem;
    height: 1.125rem;
    border: 3px solid var(--accent);
    border-radius: 50%;
    background: var(--bg);
  }

  .commit:first-child .commit-node {
    background: var(--accent);
  }

  /* 最新 (HEAD) のノードだけ波紋を出す / 최신 (HEAD) 노드만 물결을 낸다 */
  @media (prefers-reduced-motion: no-preference) {
    .commit:first-child .commit-node {
      animation: ripple 2.4s ease-out infinite;
    }
  }

  @keyframes ripple {
    from {
      box-shadow: 0 0 0 0 color-mix(in srgb, var(--accent) 45%, transparent);
    }
    to {
      box-shadow: 0 0 0 0.75rem transparent;
    }
  }
</style>
