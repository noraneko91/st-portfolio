---
import PageHero from '../../components/PageHero.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getLangStaticPaths, toLang, useTranslations } from '../../i18n/utils';
import { getProfile } from '../../lib/content';

export function getStaticPaths() {
  return getLangStaticPaths();
}

const lang = toLang(Astro.params.lang);
const t = useTranslations(lang);

const profile = await getProfile();
---

<BaseLayout lang={lang} title={t('about.title')} description={t('about.description')}>
  {/* 見出しの面とプロフィールを 1 つにまとめる (Home のプロフィールタイルがそのまま広がる形) / 제목 면과 프로필을 하나로 합친다 (Home 프로필 타일이 그대로 넓어지는 모양) */}
  <PageHero tile="profile">
    <p class="eyebrow font-mono">{t('about.title')}</p>
    <h1 class="text-title">{profile.displayName}</h1>
    <p class="text-muted">{profile.title[lang]}</p>
    <div class="intro mt-6 space-y-4">
      {profile.intro.map((paragraph) => <p>{paragraph[lang]}</p>)}
    </div>
    <dl class="kv mt-8">
      <div>
        <dt>{t('profile.location')}</dt>
        <dd>{profile.location[lang]}</dd>
      </div>
      <div>
        <dt>{t('profile.languages')}</dt>
        <dd>
          <ul>
            {
              profile.languages.map((language) => (
                <li>{language.level ? `${language.name[lang]} — ${language.level[lang]}` : language.name[lang]}</li>
              ))
            }
          </ul>
        </dd>
      </div>
    </dl>
  </PageHero>
</BaseLayout>

<style>
  .eyebrow {
    margin-bottom: 0.5rem;
    font-size: 0.8125rem;
    font-weight: 700;
    color: var(--muted);
  }

  /* 中心のメッセージなので、本文より少し大きく / 핵심 메시지라서 본문보다 조금 크게 */
  .intro {
    max-width: var(--measure);
    font-size: 1.0625rem;
  }
</style>
