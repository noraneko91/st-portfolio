---
import PageHero from '../../components/PageHero.astro';
import SkillGraph from '../../components/SkillGraph.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getLangStaticPaths, toLang, useTranslations } from '../../i18n/utils';
import { formatUsage, formatYearMonth, getCareers, getCertifications, getProjects, getSkillsWithUsage } from '../../lib/content';

export function getStaticPaths() {
  return getLangStaticPaths();
}

const lang = toLang(Astro.params.lang);
const t = useTranslations(lang);

const categories = ['language', 'framework', 'cloud', 'database', 'tool'] as const;
const skills = await getSkillsWithUsage();
const groups = categories
  .map((category) => ({ category, items: skills.filter(({ skill }) => skill.data.category === category) }))
  .filter((group) => group.items.length > 0);
const [certifications, careers, projects] = await Promise.all([getCertifications(), getCareers(), getProjects()]);
---

<BaseLayout lang={lang} title={t('skills.title')} description={t('skills.description')}>
  <PageHero tile="skills">
    <h1 class="text-title mb-3">{t('skills.title')}</h1>
    <p class="max-w-[var(--measure)] text-muted">{t('skills.note')}</p>
  </PageHero>

  <section class="block" aria-labelledby="skills-label">
    <h2 id="skills-label" class="block-label">
      <span class="font-mono" aria-hidden="true">01 —</span>
      {t('skills.section.skills')}
    </h2>
    <div class="skill-grid">
      {
        groups.map(({ category, items }) => (
          <div class="skill-card reveal">
            <h3>{t(`skillCategory.${category}`)}</h3>
            <ul>
              {items.map((usage) => (
                <li class:list={['skill', { 'skill-featured': usage.skill.data.featured }]}>
                  <div class="skill-head">
                    <span class="skill-name">{usage.skill.data.name}</span>
                    <span class="skill-usage">{formatUsage(usage, t)}</span>
                  </div>
                  {usage.skill.data.detail && <p class="skill-detail">{usage.skill.data.detail}</p>}
                </li>
              ))}
            </ul>
          </div>
        ))
      }
    </div>
  </section>

  <section class="block" aria-labelledby="certifications-label">
    <h2 id="certifications-label" class="block-label">
      <span class="font-mono" aria-hidden="true">02 —</span>
      {t('skills.section.certifications')}
    </h2>
    <ul class="cert-grid">
      {
        certifications.map(({ data }) => (
          <li class="cert reveal">
            <span class="cert-date font-mono">
              {data.date ? <time datetime={data.date}>{formatYearMonth(data.date, lang)}</time> : '—'}
            </span>
            <span class="cert-name">{data.name}</span>
          </li>
        ))
      }
    </ul>
  </section>

  {/* 線を JS で引くグラフなので、JS が動かない環境では出さない (スキルの一覧は 01 にある) / 선을 JS로 긋는 그래프라서, JS가 동작하지 않는 환경에서는 표시하지 않는다 (스킬 목록은 01에 있다) */}
  <section class="block graph-section" aria-labelledby="graph-label">
    <h2 id="graph-label" class="block-label">
      <span class="font-mono" aria-hidden="true">03 —</span>
      {t('skills.section.graph')}
    </h2>
    <p class="mb-6 max-w-[var(--measure)] text-muted">{t('skills.graph.help')}</p>
    <SkillGraph lang={lang} careers={careers} projects={projects} skills={skills} />
  </section>
</BaseLayout>

<style>
  :global(html:not(.js)) .graph-section {
    display: none;
  }

  .skill-grid {
    display: grid;
    gap: 1rem;
  }

  @media (min-width: 48rem) {
    .skill-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  .skill-card {
    padding: 1.5rem;
    border: 1px solid var(--border);
    border-radius: var(--radius);
  }

  .skill-card h3 {
    margin-bottom: 1rem;
    font-size: 1rem;
  }

  /* 年数とバーをなくしたので、行の区切り線で一覧を詰めて見せる / 연수와 막대를 없앴으므로, 행 구분선으로 목록을 촘촘하게 보여준다 */
  .skill + .skill {
    padding-top: 0.5rem;
    margin-top: 0.5rem;
    border-top: 1px solid var(--border);
  }

  .skill-head {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 1rem;
  }

  .skill-usage {
    font-size: 0.8125rem;
    color: var(--muted);
    white-space: nowrap;
  }

  .skill-detail {
    font-size: 0.8125rem;
    color: var(--muted);
  }

  /* 代表スキルは太字と点で示す (色だけに頼らない) / 대표 스킬은 굵은 글씨와 점으로 표시한다 (색에만 의존하지 않는다) */
  .skill-featured .skill-name {
    font-weight: 700;
  }

  .skill-featured .skill-name::before {
    content: '' / '';
    display: inline-block;
    width: 0.4375rem;
    height: 0.4375rem;
    margin-right: 0.5rem;
    border-radius: 50%;
    background: var(--accent);
    vertical-align: 0.125em;
  }

  .cert-grid {
    display: grid;
    gap: 0.75rem;
  }

  @media (min-width: 40rem) {
    .cert-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (min-width: 64rem) {
    .cert-grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }

  .cert {
    display: grid;
    gap: 0.25rem;
    padding: 1rem 1.25rem;
    border: 1px solid var(--border);
    border-left: 3px solid var(--accent);
    border-radius: var(--radius);
  }

  .cert-date {
    font-size: 0.75rem;
    color: var(--muted);
  }

  .cert-name {
    font-weight: 700;
    line-height: 1.5;
  }

</style>
