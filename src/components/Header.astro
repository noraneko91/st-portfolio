---
import type { Lang } from '../i18n/config';
import type { TranslationKey } from '../i18n/ja';
import { getAlternatePath, stripLang, useTranslations } from '../i18n/utils';
import { getProfile } from '../lib/content';
import CommandTrigger from './command/CommandTrigger.astro';
import LanguagePicker from './LanguagePicker.astro';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
const { displayName } = await getProfile();
const currentPath = stripLang(Astro.url.pathname).replace(/\/$/, '');

// ホームへはサイト名から移動するため、ナビには含めない / 홈은 사이트 이름으로 이동하므로 내비에는 넣지 않는다
// ラベルはページタイトルのキーを流用し、メニューと見出しの表記を一致させる / 라벨은 페이지 제목 키를 재사용해 메뉴와 제목 표기를 일치시킨다
// 一致するページは "page"、その配下（プロジェクト詳細など）は "true" で現在地を示す / 일치하는 페이지는 "page", 그 하위(프로젝트 상세 등)는 "true"로 현재 위치를 표시한다
function ariaCurrent(path: string): 'page' | 'true' | undefined {
  if (path === currentPath) return 'page';
  if (currentPath.startsWith(`${path}/`)) return 'true';
  return undefined;
}

const navItems: { path: string; label: TranslationKey }[] = [
  { path: 'about', label: 'about.title' },
  { path: 'skills', label: 'skills.title' },
  { path: 'projects', label: 'projects.title' },
  { path: 'contact', label: 'contact.title' },
];
---

<a href="#main" class="skip-link">{t('nav.skip')}</a>
<header class="site-header">
  <div class="wrapper header-inner">
    <a href={getAlternatePath(lang, '')} class="brand" aria-current={currentPath === '' ? 'page' : undefined}>
      <span class="brand-name">{displayName}</span>
      <span class="brand-suffix">{t('site.suffix')}</span>
    </a>
    <nav class="nav" aria-label={t('nav.label')}>
      <ul>
        {
          navItems.map((item) => (
            <li>
              <a href={getAlternatePath(lang, item.path)} aria-current={ariaCurrent(item.path)}>
                {t(item.label)}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
    {/* 右端に固定し、右揃えの言語メニューが画面外にはみ出さないようにする / 오른쪽 끝에 고정해 오른쪽 정렬 언어 메뉴가 화면 밖으로 나가지 않게 한다 */}
    <div class="lang">
      <CommandTrigger lang={lang} />
      <LanguagePicker lang={lang} />
    </div>
  </div>
</header>

<style>
  /* キーボード操作時だけ表示する / 키보드 조작 시에만 표시한다 */
  .skip-link {
    position: absolute;
    top: 0.5rem;
    left: var(--gutter);
    z-index: 20;
    padding: 0.5rem 0.75rem;
    border: 1px solid var(--accent);
    background: var(--bg);
    transform: translateY(-200%);
  }

  .skip-link:focus {
    transform: none;
  }

  /* ページ遷移時にヘッダーを固定し、本文だけを切り替える / 페이지 전환 시 헤더는 고정하고 본문만 바꾼다 */
  /*
   * view-transition-name でヘッダーは独立した重なり順になるため、ヘッダーごと本文より上に置く (言語メニューが本文に隠れて押せなくならないように)
   * view-transition-name으로 헤더는 독립된 쌓임 순서가 되므로, 헤더째 본문보다 위에 둔다 (언어 메뉴가 본문에 가려져 눌리지 않게 되지 않도록)
   */
  .site-header {
    position: relative;
    z-index: 20;
    border-bottom: 1px solid var(--border);
    view-transition-name: site-header;
  }

  /* 狭い画面: 1行目にサイト名と言語、2行目にナビ / 좁은 화면: 1행에 사이트 이름과 언어, 2행에 내비 */
  .header-inner {
    display: grid;
    grid-template-columns: 1fr auto;
    grid-template-areas:
      'brand lang'
      'nav nav';
    align-items: center;
    column-gap: 1.5rem;
    padding-block: 0.5rem;
  }

  /* 表示名 (固定幅・太字) + ポートフォリオ (言語別) をロゴとして使う / 표시 이름 (고정폭·굵은 글자) + 포트폴리오 (언어별)를 로고로 쓴다 */
  .brand {
    display: inline-flex;
    align-items: baseline;
    gap: 0.5rem;
    grid-area: brand;
    color: var(--text);
    text-decoration: none;
  }

  .brand-name {
    font-family: var(--font-mono);
    font-size: 1.0625rem;
    font-weight: 700;
  }

  .brand-suffix {
    font-size: 0.875rem;
    color: var(--muted);
  }

  /* 狭い画面ではボタンと1行に収めるため、表示名だけにする / 좁은 화면에서는 버튼과 한 줄에 들어가도록 표시 이름만 둔다 */
  @media (max-width: 47.99rem) {
    .brand-suffix {
      display: none;
    }
  }

  .nav {
    grid-area: nav;
  }

  .nav ul {
    display: flex;
    flex-wrap: wrap;
    column-gap: 1.25rem;
  }

  /* タップ領域 44px。下線は透明で用意しておき、hover で薄く出す / 탭 영역 44px. 밑줄은 투명하게 준비해 두고 hover 시 옅게 표시한다 */
  .nav a {
    display: inline-flex;
    align-items: center;
    min-height: 2.75rem;
    color: var(--muted);
    text-decoration: underline 1px transparent;
    text-underline-offset: 0.5em;
  }

  .nav a:hover {
    color: var(--text);
    text-decoration-color: var(--control-border);
  }

  /* 現在地は太字とテーマ色の太い下線で示す (色だけに頼らない) / 현재 위치는 굵은 글자와 포인트 컬러의 굵은 밑줄로 표시한다 (색에만 의존하지 않는다) */
  .nav a[aria-current] {
    color: var(--text);
    font-weight: 700;
    text-decoration: underline 3px var(--accent);
  }

  .lang {
    display: flex;
    gap: 0.5rem;
    grid-area: lang;
    justify-self: end;
  }

  @media (min-width: 48rem) {
    .header-inner {
      grid-template-columns: auto 1fr auto;
      grid-template-areas: 'brand nav lang';
      padding-block: 0.75rem;
    }

    .nav ul {
      justify-content: flex-end;
    }
  }
</style>
