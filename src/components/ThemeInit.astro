---
import { THEME_STORAGE_KEY } from '../lib/theme';
---

{/* 描画前に保存済みのテーマを当て、読み込み時にライト → ダークと点滅しないようにする / 그리기 전에 저장된 테마를 적용해, 로드 시 라이트 → 다크로 깜박이지 않게 한다 */}
<script is:inline define:vars={{ key: THEME_STORAGE_KEY }}>
  try {
    const theme = localStorage.getItem(key);
    if (theme === 'light' || theme === 'dark') document.documentElement.dataset.theme = theme;
  } catch {
    // 保存領域が使えない環境では OS の設定のまま / 저장 영역을 쓸 수 없는 환경에서는 OS 설정 그대로
  }
</script>
