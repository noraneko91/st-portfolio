---
import { htmlLang, languageNames, locales, type Lang } from '../i18n/config';
import { getAlternatePath, useTranslations } from '../i18n/utils';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
const pathname = Astro.url.pathname;
---

{/* JS なしでは言語リンクの一覧として表示し、JS で WAI-ARIA の Menu Button に拡張する / JS 없이는 언어 링크 목록으로 표시하고, JS로 WAI-ARIA Menu Button으로 확장한다 */}
{/* 右端への配置は Header 側のグリッドで行う / 오른쪽 끝 배치는 Header 쪽 그리드에서 한다 */}
<div class="relative" data-lang-picker>
  <button
    type="button"
    class="lang-button"
    id="lang-button"
    aria-haspopup="menu"
    aria-expanded="false"
    aria-controls="lang-menu"
    data-lang-button
  >
    <span>{lang.toUpperCase()}</span>
    <span class="sr-only">{t('lang.label')}</span>
    <span class="caret" aria-hidden="true">▾</span>
  </button>
  <ul id="lang-menu" class="flex flex-wrap gap-x-3" data-lang-menu>
    {
      locales.map((l) => (
        <li>
          <a
            href={getAlternatePath(l, pathname)}
            hreflang={htmlLang[l]}
            lang={htmlLang[l]}
            aria-current={l === lang ? 'true' : undefined}
            data-lang={l}
          >
            <span aria-hidden="true">{l.toUpperCase()}</span> {languageNames[l]}
          </a>
        </li>
      ))
    }
  </ul>
</div>

<style>
  /* 表示の切り替えは html.js で最初の描画から決める (スクリプト実行後に切り替えると高さが変わり CLS になる) / 표시 전환은 html.js로 첫 그리기부터 정한다 (스크립트 실행 후에 바꾸면 높이가 바뀌어 CLS가 된다) */
  :global(html:not(.js)) [data-lang-button],
  :global(html.js) [data-lang-picker]:not([data-enhanced]) [data-lang-menu] {
    display: none;
  }

  [data-enhanced] [data-lang-menu] {
    position: absolute;
    top: 100%;
    right: 0;
    z-index: 10;
    flex-direction: column;
    min-width: max-content;
    margin-top: 0.25rem;
    padding: 0.25rem 0;
    border: 1px solid;
    background: var(--bg);
    border-color: var(--border);
  }

  [data-enhanced] [data-lang-menu] a {
    display: flex;
    align-items: center;
    gap: 0.375rem;
    min-height: 2.75rem;
    padding-inline: 1rem;
    color: var(--text);
    text-decoration: none;
  }

  [data-enhanced] [data-lang-menu] a:hover,
  [data-enhanced] [data-lang-menu] a:focus-visible {
    background: var(--surface);
  }

  [data-enhanced] [data-lang-menu] a[aria-checked='true'] {
    color: var(--accent);
  }

  /* 枠のあるボタンにして、テキストと区別する。タップ領域 44px / 테두리 있는 버튼으로 해서 텍스트와 구분한다. 탭 영역 44px */
  .lang-button {
    display: inline-flex;
    align-items: center;
    gap: 0.375rem;
    min-width: 2.75rem;
    min-height: 2.75rem;
    padding-inline: 0.75rem;
    border: 1px solid var(--control-border);
    border-radius: 2px;
    font-family: var(--font-mono);
    font-size: 0.875rem;
    color: var(--text);
  }

  .lang-button:hover {
    background: var(--surface);
  }

  .lang-button:active {
    transform: translateY(1px);
  }

  /* 開いている状態を背景・テーマ色の枠・▾ の向きで示す / 열린 상태를 배경·포인트 컬러 테두리·▾ 방향으로 표시한다 */
  .lang-button[aria-expanded='true'] {
    border-color: var(--accent);
    background: var(--surface);
  }

  .lang-button[aria-expanded='true'] .caret {
    transform: rotate(180deg);
  }

  .caret {
    display: inline-block;
  }

  @media (prefers-reduced-motion: no-preference) {
    .caret {
      transition: transform 150ms ease;
    }
  }

  /* 選択状態は aria-checked で伝わるので、記号は読み上げない / 선택 상태는 aria-checked로 전달되므로 기호는 읽지 않는다 */
  [role='menuitemradio']::before {
    content: '○' / '';
    margin-right: 0.5rem;
  }

  [role='menuitemradio'][aria-checked='true']::before {
    content: '●' / '';
  }
</style>

<script>
  import { isLang, LANG_STORAGE_KEY } from '../i18n/config';

  function setup(root: HTMLElement) {
    const button = root.querySelector<HTMLButtonElement>('[data-lang-button]');
    const menu = root.querySelector<HTMLElement>('[data-lang-menu]');
    if (!button || !menu) return;
    const items = Array.from(menu.querySelectorAll<HTMLAnchorElement>('a[data-lang]'));

    // ロールは JS で付ける。JS なしでメニューのロールだけ残るとキーボード操作と矛盾するため / 롤은 JS로 붙인다. JS 없이 메뉴 롤만 남으면 키보드 조작과 맞지 않기 때문
    menu.setAttribute('role', 'menu');
    menu.setAttribute('aria-labelledby', button.id);
    for (const li of menu.querySelectorAll('li')) li.setAttribute('role', 'none');
    for (const item of items) {
      item.setAttribute('role', 'menuitemradio');
      item.setAttribute('aria-checked', String(item.hasAttribute('aria-current')));
      item.removeAttribute('aria-current');
      item.tabIndex = -1;
    }
    menu.hidden = true;
    button.hidden = false;
    root.dataset.enhanced = '';

    const checkedIndex = Math.max(
      0,
      items.findIndex((item) => item.getAttribute('aria-checked') === 'true'),
    );

    const focusItem = (index: number) => {
      items[(index + items.length) % items.length]?.focus();
    };

    const open = (index: number) => {
      menu.hidden = false;
      button.setAttribute('aria-expanded', 'true');
      focusItem(index);
    };

    const close = (returnFocus: boolean) => {
      menu.hidden = true;
      button.setAttribute('aria-expanded', 'false');
      if (returnFocus) button.focus();
    };

    button.addEventListener('click', () => {
      if (menu.hidden) open(checkedIndex);
      else close(false);
    });

    button.addEventListener('keydown', (event) => {
      if (event.key === 'ArrowDown') {
        event.preventDefault();
        open(checkedIndex);
      } else if (event.key === 'ArrowUp') {
        event.preventDefault();
        open(items.length - 1);
      }
    });

    menu.addEventListener('keydown', (event) => {
      const index = items.findIndex((item) => item === document.activeElement);
      switch (event.key) {
        case 'ArrowDown':
          event.preventDefault();
          focusItem(index + 1);
          break;
        case 'ArrowUp':
          event.preventDefault();
          focusItem(index - 1);
          break;
        case 'Home':
          event.preventDefault();
          focusItem(0);
          break;
        case 'End':
          event.preventDefault();
          focusItem(items.length - 1);
          break;
        case 'Escape':
          event.preventDefault();
          close(true);
          break;
        case 'Tab':
          close(false);
          break;
        // リンクは Enter でしか動かないため、メニュー項目として Space でも選択できるようにする / 링크는 Enter로만 동작하므로 메뉴 항목으로서 Space로도 선택할 수 있게 한다
        case ' ':
          event.preventDefault();
          items[index]?.click();
          break;
      }
    });

    for (const item of items) {
      item.addEventListener('click', () => {
        const lang = item.dataset.lang;
        if (!isLang(lang)) return;
        try {
          localStorage.setItem(LANG_STORAGE_KEY, lang);
        } catch {
          // 保存できない環境（プライベートモード等）でも遷移は続ける / 저장할 수 없는 환경(프라이빗 모드 등)에서도 이동은 계속한다
        }
      });
    }

    document.addEventListener('click', (event) => {
      if (!menu.hidden && event.target instanceof Node && !root.contains(event.target)) close(false);
    });
  }

  for (const root of document.querySelectorAll<HTMLElement>('[data-lang-picker]')) setup(root);
</script>
