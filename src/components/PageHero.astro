---
// Home のタイルと同じ名前 (tile-*) を持つページ見出しの面 / Home 타일과 같은 이름 (tile-*)을 가진 페이지 제목 면
export type TileName = 'profile' | 'work' | 'personal' | 'skills' | 'contact';

interface Props {
  tile: TileName;
}

const { tile } = Astro.props;
---

{/* 同じ view-transition-name の要素どうしが遷移でつながる (1 ページに 1 つだけ) / 같은 view-transition-name 요소끼리 전환으로 이어진다 (한 페이지에 하나만) */}
<div class="page-hero panel" style={`view-transition-name: tile-${tile}`}>
  <slot />
</div>

<style>
  .page-hero {
    margin-bottom: 2.5rem;
    padding: clamp(1.25rem, 0.75rem + 2.5vw, 2.5rem);
  }
</style>
