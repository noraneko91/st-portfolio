---
import type { Lang } from '../i18n/config';
import type { Project } from '../lib/content';

interface Props {
  project: Project;
  lang: Lang;
}

const { project, lang } = Astro.props;
const { data } = project;
---

{/* 画像があればそれを使い、なければパスから表紙を描く (技術はカードのチップで示す) (画像を作らなくても一覧が成り立つように) / 이미지가 있으면 그것을 쓰고, 없으면 경로로 표지를 그린다 (기술은 카드의 칩으로 표시한다) (이미지를 만들지 않아도 목록이 성립하도록) */}
<div class="cover">
  {
    data.thumbnail ? (
      <img src={data.thumbnail.src} alt={data.thumbnail.alt[lang]} width="1200" height="675" loading="lazy" decoding="async" />
    ) : (
      <div class="cover-art" aria-hidden="true">
        <span class="cover-path font-mono">{`~/projects/${project.id}`}</span>
      </div>
    )
  }
</div>

<style>
  .cover {
    position: relative;
    overflow: hidden;
    aspect-ratio: 16 / 9;
    border-bottom: 1px solid var(--border);
    background-color: var(--surface);
  }

  .cover img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  /* 方眼紙とテーマ色のにじみで、サイト全体の雰囲気に合わせる / 방안지와 포인트 컬러 번짐으로 사이트 전체 분위기에 맞춘다 */
  .cover-art {
    position: absolute;
    inset: 0;
    display: grid;
    align-content: end;
    gap: 0.375rem;
    padding: 1.25rem 1.5rem;
    background-image:
      radial-gradient(60% 80% at 80% 20%, var(--glow), transparent 70%),
      linear-gradient(var(--grid-strong) 1px, transparent 1px),
      linear-gradient(90deg, var(--grid-strong) 1px, transparent 1px);
    background-size:
      100% 100%,
      24px 24px,
      24px 24px;
  }

  /* タイトルと技術はカード本文にあるので、表紙はパスだけにする / 제목과 기술은 카드 본문에 있으므로 표지는 경로만 둔다 */
  .cover-path {
    font-size: clamp(1rem, 0.85rem + 0.8vw, 1.375rem);
    font-weight: 700;
    color: var(--accent);
    overflow-wrap: anywhere;
  }


</style>
