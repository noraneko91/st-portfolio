---
import type { Lang } from '../i18n/config';
import { useTranslations } from '../i18n/utils';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
---

{/*
  ダークモードのオン・オフを切り替えるボタン (aria-pressed で状態を伝える)。アイコンは CSS だけで出し分けるので、読み込み直後もずれない
  다크 모드 켜기·끄기 버튼 (aria-pressed로 상태를 전달한다). 아이콘은 CSS만으로 구분해 표시하므로 로드 직후에도 어긋나지 않는다
*/}
<button type="button" class="theme-button" data-theme-toggle aria-pressed="false" aria-label={t('theme.dark')}>
  <svg class="icon icon-moon" viewBox="0 0 24 24" width="18" height="18" aria-hidden="true">
    <path d="M20 14.5A8 8 0 0 1 9.5 4a8 8 0 1 0 10.5 10.5Z" fill="none" stroke="currentColor" stroke-width="2" stroke-linejoin="round"></path>
  </svg>
  <svg class="icon icon-sun" viewBox="0 0 24 24" width="18" height="18" aria-hidden="true">
    <circle cx="12" cy="12" r="4" fill="none" stroke="currentColor" stroke-width="2"></circle>
    <path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4" stroke="currentColor" stroke-width="2" stroke-linecap="round"></path>
  </svg>
</button>

<script>
  import { THEME_STORAGE_KEY, type Theme } from '../lib/theme';

  const root = document.documentElement;
  const system = matchMedia('(prefers-color-scheme: dark)');
  const isDark = () => (root.dataset.theme ? root.dataset.theme === 'dark' : system.matches);

  for (const button of document.querySelectorAll<HTMLButtonElement>('[data-theme-toggle]')) {
    const sync = () => button.setAttribute('aria-pressed', String(isDark()));
    sync();
    button.addEventListener('click', () => {
      const next: Theme = isDark() ? 'light' : 'dark';
      root.dataset.theme = next;
      try {
        localStorage.setItem(THEME_STORAGE_KEY, next);
      } catch {
        // 保存できなくても、このページの表示は切り替える / 저장할 수 없어도 이 페이지의 표시는 바꾼다
      }
      sync();
    });
    // 選んでいない間は OS の切り替えに追従する / 고르지 않은 동안은 OS 전환을 따른다
    system.addEventListener('change', sync);
  }
</script>

<style>
  /* JS がないと切り替えられないので出さない (OS の設定に従う) / JS가 없으면 바꿀 수 없으므로 표시하지 않는다 (OS 설정을 따른다) */
  :global(html:not(.js)) .theme-button {
    display: none;
  }

  /* 言語ボタンと同じ形・大きさ (タップ領域 44px) / 언어 버튼과 같은 모양·크기 (탭 영역 44px) */
  .theme-button {
    display: inline-grid;
    place-items: center;
    width: 2.75rem;
    height: 2.75rem;
    border: 1px solid var(--control-border);
    border-radius: var(--radius);
    color: var(--text);
    cursor: pointer;
  }

  .theme-button:hover {
    background: var(--surface);
  }

  .theme-button:active {
    transform: translateY(1px);
  }

  /* ライトでは月 (押すとダーク)、ダークでは太陽 (押すとライト) / 라이트에서는 달 (누르면 다크), 다크에서는 해 (누르면 라이트) */
  .icon-sun {
    display: none;
  }

  :global(:root[data-theme='dark']) .icon-moon {
    display: none;
  }

  :global(:root[data-theme='dark']) .icon-sun {
    display: block;
  }

  @media (prefers-color-scheme: dark) {
    :global(:root:not([data-theme='light'])) .icon-moon {
      display: none;
    }

    :global(:root:not([data-theme='light'])) .icon-sun {
      display: block;
    }
  }
</style>
