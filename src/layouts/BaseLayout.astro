---
import '../styles/global.css';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import { defaultLocale, htmlLang, locales, ogLocale, type Lang } from '../i18n/config';
import { getAlternateUrl, useTranslations } from '../i18n/utils';

interface Props {
  lang: Lang;
  // 省略時はサイト名のみ（ホーム用） / 생략하면 사이트 이름만 (홈용)
  title?: string;
  description: string;
  // ページ固有の背景など、body に付けるクラス / 페이지 고유 배경 등 body에 붙이는 클래스
  bodyClass?: string;
}

const { lang, title, description, bodyClass } = Astro.props;
const t = useTranslations(lang);
const pathname = Astro.url.pathname;
const documentTitle = title ? `${title} | ${t('site.name')}` : t('site.name');
const canonical = getAlternateUrl(lang, pathname);
// 全ページ共通の画像。原本は scripts/brand/og-image.svg / 모든 페이지 공통 이미지. 원본은 scripts/brand/og-image.svg
const ogImage = new URL('/og-image.png', Astro.site).href;
---

<!doctype html>
<html lang={htmlLang[lang]}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{documentTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {locales.map((l) => <link rel="alternate" hreflang={htmlLang[l]} href={getAlternateUrl(l, pathname)} />)}
    {/* x-default は原文の ja を指す (ルートは noindex のため) / x-default는 원문인 ja를 가리킨다 (루트는 noindex이므로) */}
    <link rel="alternate" hreflang="x-default" href={getAlternateUrl(defaultLocale, pathname)} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    {/* SNS で共有されたときの表示 / SNS에 공유되었을 때의 표시 */}
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={t('site.name')} />
    <meta property="og:title" content={documentTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content={ogLocale[lang]} />
    {locales.filter((l) => l !== lang).map((l) => <meta property="og:locale:alternate" content={ogLocale[l]} />)}
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={t('og.imageAlt')} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="generator" content={Astro.generator} />
  </head>
  {/* 本文が短いページでもフッターを画面の下端に置く / 본문이 짧은 페이지에서도 푸터를 화면 아래 끝에 둔다 */}
  <body class:list={['flex min-h-dvh flex-col', bodyClass]}>
    <Header lang={lang} />
    <main id="main" class="wrapper page-main flex-1">
      <slot />
    </main>
    <Footer lang={lang} />
  </body>
</html>

<style>
  .page-main {
    padding-block: clamp(2.5rem, 1.5rem + 5vw, 5rem) 5rem;
  }
</style>
