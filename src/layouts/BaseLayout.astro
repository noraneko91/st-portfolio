---
import '../styles/global.css';
import DepthBackground from '../components/DepthBackground.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import { defaultLocale, htmlLang, locales, ogLocale, type Lang } from '../i18n/config';
import { getAlternateUrl, useTranslations } from '../i18n/utils';
import { getProfile } from '../lib/content';

interface Props {
  lang: Lang;
  // 省略時はサイト名のみ（ホーム用） / 생략하면 사이트 이름만 (홈용)
  title?: string;
  description: string;
  // Home は 1 画面に収めるため余白を詰め、背景の床を動かす / Home은 한 화면에 담기 위해 여백을 줄이고 배경 바닥을 움직인다
  home?: boolean;
}

const { lang, title, description, home = false } = Astro.props;
const t = useTranslations(lang);
const pathname = Astro.url.pathname;
// サイト名は「表示名 + ポートフォリオ (言語別)」 / 사이트 이름은 "표시 이름 + 포트폴리오 (언어별)"
const { displayName } = await getProfile();
const siteName = `${displayName} ${t('site.suffix')}`;
const documentTitle = title ? `${title} | ${siteName}` : siteName;
const canonical = getAlternateUrl(lang, pathname);
// 全ページ共通の画像。原本は scripts/brand/og-image.svg / 모든 페이지 공통 이미지. 원본은 scripts/brand/og-image.svg
const ogImage = new URL('/og-image.png', Astro.site).href;
---

<!doctype html>
<html lang={htmlLang[lang]}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    {/* JS が動く環境かを描画前に CSS へ伝え、言語メニューの切り替えでレイアウトがずれないようにする / JS가 동작하는 환경인지 그리기 전에 CSS에 알려, 언어 메뉴 전환으로 레이아웃이 밀리지 않게 한다 */}
    <script is:inline>document.documentElement.classList.add('js');</script>
    <title>{documentTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {locales.map((l) => <link rel="alternate" hreflang={htmlLang[l]} href={getAlternateUrl(l, pathname)} />)}
    {/* x-default は原文の ja を指す (ルートは noindex のため) / x-default는 원문인 ja를 가리킨다 (루트는 noindex이므로) */}
    <link rel="alternate" hreflang="x-default" href={getAlternateUrl(defaultLocale, pathname)} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    {/* SNS で共有されたときの表示 / SNS에 공유되었을 때의 표시 */}
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={siteName} />
    <meta property="og:title" content={documentTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content={ogLocale[lang]} />
    {locales.filter((l) => l !== lang).map((l) => <meta property="og:locale:alternate" content={ogLocale[l]} />)}
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={t('og.imageAlt')} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="generator" content={Astro.generator} />
  </head>
  {/* 本文が短いページでもフッターを画面の下端に置く / 본문이 짧은 페이지에서도 푸터를 화면 아래 끝에 둔다 */}
  <body class="flex min-h-dvh flex-col">
    <DepthBackground animate={home} />
    <Header lang={lang} />
    <main id="main" class:list={['wrapper flex-1', home ? 'page-main-home' : 'page-main']}>
      <slot />
    </main>
    <Footer lang={lang} />
  </body>
</html>

<style>
  .page-main {
    padding-block: clamp(2.5rem, 1.5rem + 5vw, 5rem) 5rem;
  }

  .page-main-home {
    padding-block: 1.25rem 2.5rem;
  }
</style>
